// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "library" 
}

datasource db {
  provider = "postgresql"
}
model Tenant {
  id           String        @id @default(uuid())
  name         String
  environments Environment[]
  featureFlags FeatureFlag[] // Relation added
  createdAt    DateTime      @default(now())
}

model Environment {
  id        String       @id @default(uuid())
  name      String
  apiKey    String       @unique @default(dbgenerated("gen_random_uuid()"))
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statuses  FlagStatus[]
  createdAt DateTime     @default(now())
}

model FeatureFlag {
  id          String       @id @default(uuid())
  key         String       // Removed global @unique
  description String?
  tenantId    String       // Linked to Tenant
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statuses    FlagStatus[]
  createdAt   DateTime     @default(now())

  // This ensures "new-ui" key can be used once per tenant!
  @@unique([tenantId, key])
}

model FlagStatus {
  id            String      @id @default(uuid())
  environmentId String
  flagId        String
  isEnabled     Boolean     @default(false)
  rules         Json?
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  flag          FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([environmentId, flagId])
}